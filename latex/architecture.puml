@startuml
!theme plain

title Архитектура платформы обнаружения аномалий

rectangle "PCAP файлы" as pcap
rectangle "Сетевой интерфейс" as net
rectangle "Генератор данных" as gen

rectangle "Сбор пакетов\n(PacketCapture)" as capture #87CEEB
rectangle "Извлечение признаков\n(FeatureExtractor)" as features #98FB98
rectangle "ML-детектор\n(AnomalyDetector)" as detector #FFB6C1
rectangle "Правила\n(RuleBasedDetector)" as rules #FFD700
rectangle "Визуализация\n(Plots)" as viz #DDA0DD
rectangle "Сохранение\n(CSV / joblib)" as storage #D3D3D3

net --> capture : live-захват
pcap --> capture : чтение PCAP
gen --> capture : синтетические данные

capture --> features : сырые пакеты
features --> detector : признаки окон
features --> rules : признаки окон

detector --> viz : оценки аномалий
rules --> viz : срабатывания правил
viz --> storage : графики и CSV

note right of detector
  Isolation Forest
  LOF
  One-Class SVM
end note

note right of rules
  high_syn_ratio
  high_packet_rate
  high_port_entropy
  many_unique_ports
  low_pkt_high_bytes
end note

@enduml
